# AI Code Models Stack Configuration
# Use with: podman-compose --env-file .env up -d

# --- Model Selection ---
# Model GGUF filename for llama-coder service
LLAMA_MODEL=qwen2.5-coder-7b-instruct-q4_k_m.gguf
# Model-specific GPU layers (-1 = all, 999 = most)
N_GPU_LAYERS=999
# Context size for the model
CTX_SIZE=8192
# Port mapping (host:container)
LLAMA_PORT=8081

# --- API Configuration ---
# Replace with your actual OpenAI API key or leave as-is for local-only mode
OPENAI_API_KEY=locall-llama

# --- Web Search ---
# Enable web search in Open WebUI
ENABLE_WEB_SEARCH=true
# Options: duckduckgo, google, bing
WEB_SEARCH_ENGINE=duckduckgo

# --- Logging ---
LOG_LEVEL=INFO

# --- Huggingface token ---
HF_TOKEN=<token>

# --- Models Storage Directory ---
# Directory on host where models are temporarily downloaded before being copied to the container volume.
# Default is /tmp/llama_models (which may hit tmpfs space/quota limits).
# You can change it to a local folder in this repo (e.g., ./models) or another location on your main disk.
# MODELS_DIR=./models

