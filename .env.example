# AI Code Models Stack Configuration
# Use with: podman-compose --env-file .env up -d

# --- Model Selection ---
# Container name for the single model service
LLAMA_CONTAINER_NAME=llama-coder
# Model GGUF filename for the service
LLAMA_MODEL=Qwen3-14B-Q4_K_M.gguf
# Model-specific GPU layers (-1 = all, 999 = most)
N_GPU_LAYERS=10
# Context size for the model
CTX_SIZE=32768
# Port mapping (host:container)
LLAMA_PORT=8081

# --- Second model (extra profile) ---
LLAMA_DEVS_MODEL=mistralai_Devstral-Small-2-24B-Instruct-2512-Q4_K_M.gguf
LLAMA_DEVS_N_GPU_LAYERS=20
LLAMA_DEVS_CTX_SIZE=32768
LLAMA_DEVS_PORT=8082

# --- API Configuration ---
# Replace with your actual OpenAI API key or leave as-is for local-only mode
OPENAI_API_KEY=locall-llama

# --- Web Search ---
# Enable web search in Open WebUI
ENABLE_WEB_SEARCH=true
# Options: duckduckgo, google, bing
WEB_SEARCH_ENGINE=duckduckgo

# --- Logging ---
LOG_LEVEL=INFO

# --- Huggingface token ---
HF_TOKEN=<token>

# --- Models Storage Directory ---
# Colon-separated list of model directories (first is writable, rest are read-only fallback).
# Default is /tmp/llama_models.
# MODEL_DIRS=./models:/mnt/usb/models:/mnt/nas/models
#
# Legacy single-directory env var (used if MODEL_DIRS is not set):
# MODELS_DIR=./models

